# Environment Variables — Selfysnap Backend
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/selfysnap

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<your_jwt_secret>

# ─── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=<your_key_id>
RAZORPAY_KEY_SECRET=<your_key_secret>

# ─── Delivery One API ─────────────────────────────────────────────────────────
# IMPORTANT: Rotate your key at https://app.deliveryone.in/settings/api
# Never share or commit this key!
DELIVERY_ONE_API_KEY=<your_rotated_api_key>
DELIVERY_ONE_BASE_URL=https://api.deliveryone.in/v1

# Webhook signature secret (get from Delivery One dashboard → Webhooks)
DELIVERY_ONE_WEBHOOK_SECRET=<your_webhook_secret>

# ─── Delhivery B2C API ────────────────────────────────────────────────────────
# Base URL for track/staging: https://track.delhivery.com or https://staging-express.delhivery.com
DELHIVERY_BASE_URL=https://track.delhivery.com
DELHIVERY_API_TOKEN=<your_delhivery_token>

# ─── Cloudinary (for product images) ─────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>
